# Database
DATABASE_URL=postgresql+asyncpg://li:li@localhost:5432/latent_intelligence
DATABASE_SYNC_URL=postgresql://li:li@localhost:5432/latent_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=latentintelligence

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=latent-intelligence

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Auth
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Claude API (for module descriptions)
ANTHROPIC_API_KEY=

# App
APP_NAME=Latent Intelligence
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
