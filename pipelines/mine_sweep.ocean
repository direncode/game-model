# /mine-sweep — substrate sort-by-structural-unusualness on
# NOAA bathymetry, evaluated against NOAA Wrecks-and-Obstructions labels.
#
# Companion to scripts/experiments/mine_sweep.py. Together they produce
# the data backing data/validation/mine_sweep/summary.json and the
# /mine-sweep showcase page (only if the B-gate verdict in that summary
# is SHIP_A).
#
# Per spec docs/superpowers/specs/2026-05-11-mine-sweep-design.md.
#
# The literal `take 447 records` count is regenerated by the harness at
# execution time from features.parquet's row count, so this file is
# always consistent with the actual corpus the substrate ran on.

seed 42

sweep s from 42 to 44 do
    load data/validation/mine_sweep/features.ndjson take 447 records
    embed numeric features [residual_rms, local_relief, slope_std, laplacian_std]
    cluster for 16 rounds max 256 modules energy = corpus mean
    save to data/validation/mine_sweep/modules_seed_${s}.json
end
