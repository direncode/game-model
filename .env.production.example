# ══════════════════════════════════════════════
# Latent Intelligence — Production Environment
# ══════════════════════════════════════════════
# Copy to .env.production and fill in real values.
# NEVER commit .env.production to git.

# ─── Database ───
POSTGRES_DB=latent_intelligence
POSTGRES_USER=li
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32

# ─── Neo4j ───
NEO4J_PASSWORD=CHANGE_ME_strong_password

# ─── MinIO (Object Storage) ───
MINIO_ACCESS_KEY=CHANGE_ME_minio_access
MINIO_SECRET_KEY=CHANGE_ME_minio_secret

# ─── Auth ───
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Claude API (for module descriptions) ───
ANTHROPIC_API_KEY=

# ─── App ───
APP_NAME=Latent Intelligence
APP_ENV=production
APP_DEBUG=false

# ─── Frontend URLs (baked at build time) ───
NEXT_PUBLIC_API_URL=https://latentocean.com
NEXT_PUBLIC_WS_URL=wss://latentocean.com
