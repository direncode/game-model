# Titan - cross-domain benchmark records.
# Free-tier: tf-idf + kmeans. Premium: content fingerprint + tcd recursive loop.

## titan.benchmark - Titan benchmark records, free-tier substrate clustering.
## Default corpus: 300-record sample of the Titan benchmark.
define benchmark(corpus = "stdlib/data/titan/benchmark_demo.ndjson", target = 300, embed_dim = 64, iters = 8, output = "data/showcases/titan/benchmark_artifact.json") do
    load corpus take target records balanced by domain label field is domain
    embed text into embed_dim dimensions using tf-idf
    cluster for iters rounds max 24 modules energy = corpus mean using kmeans
    align modules using 50 nearest records fine label field is size_class
    save to output
end

## titan.benchmark_pro - same shape, premium operators. Requires OCEAN_API_KEY.
define benchmark_pro(corpus = "stdlib/data/titan/benchmark_demo.ndjson", target = 300, output = "data/showcases/titan/benchmark_artifact_pro.json") do
    load corpus take target records balanced by domain label field is domain
    embed text into 48 dimensions using content fingerprint
    cluster for 16 rounds max 24 modules energy = corpus mean crystallize every 4 using tcd recursive loop
    align modules using 50 nearest records fine label field is size_class
    find dispersion of each label
    save to output
end
